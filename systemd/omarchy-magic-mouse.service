[Unit]
Description=Omarchy Magic Mouse — inertial scrolling, smooth wheel, swipe gestures
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/.local/share/omarchy-magic-mouse/bin/omarchy-magic-mouse run
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
