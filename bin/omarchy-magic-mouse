#!/usr/bin/env python3
"""omarchy-magic-mouse — macOS Magic Mouse behaviour for Omarchy.

Installed to ~/.local/share/omarchy-magic-mouse and symlinked from
~/.local/bin; resolves its own tree so the symlink always loads the
matching package.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from magicmouse.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
